# Documentation only: weather.py does not auto-load .env files.
# Set these variables in the process that runs Python.
GALEWEATHER_API_KEY=REPLACE_LOCALLY_DO_NOT_COMMIT
# Trusted base URL only; do not append /forecast, a query string, or a key.
# Production HTTPS availability still needs service-provider verification.
GALEWEATHER_BASE_URL=https://www.galeweather.cn/api/v1/weather
# Keep 0 for HTTPS. Set 1 only after explicitly accepting HTTP plaintext risk.
GALEWEATHER_ALLOW_HTTP=0
